{
  "name": "@npb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query-driver": {
      "types": "./src/query-driver.ts",
      "import": "./src/query-driver.ts",
      "default": "./src/query-driver.ts"
    },
    "./sqlite-stack": {
      "types": "./src/sqlite-stack.ts",
      "import": "./src/sqlite-stack.ts",
      "default": "./src/sqlite-stack.ts"
    }
  },
  "dependencies": {
    "@npb/crawler": "workspace:*",
    "@npb/parser": "workspace:*",
    "@npb/schemas": "workspace:*"
  },
  "scripts": {
    "backfill:scores-canonical": "node --import tsx ./src/cli.ts backfill:scores-canonical",
    "enrich:bis-farm-boxes": "node --import tsx ./src/cli.ts enrich:bis-farm-boxes",
    "enrich:scores-calendar": "node --import tsx ./src/cli.ts enrich:scores-calendar",
    "lint": "eslint -c ../../eslint.config.mjs .",
    "migrate": "node --import tsx ./src/cli.ts migrate",
    "rebuild:r2-year": "node --import tsx ./src/cli.ts rebuild:r2-year",
    "sync:d1": "node --import tsx ./src/cli.ts sync:d1",
    "update:bis-current": "node --import tsx ./src/cli.ts update:bis-current",
    "update:daily": "node --import tsx ./src/cli.ts update:daily",
    "update:year": "node --import tsx ./src/cli.ts update-year",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
